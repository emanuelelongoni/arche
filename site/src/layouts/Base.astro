---
import "../styles/global.css";
import { REPO_URL, data } from "../lib/data";
import { THEME_INIT } from "../scripts/theme-init.mjs";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = "Archē: a map of undergraduate mathematics, its prerequisites and its routes.", wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/map/", label: "Map", match: "/map/" },
  { href: "/topics/", label: "Topics", match: "/topics/" },
  { href: "/courses/", label: "Courses", match: "/courses/" },
  { href: "/route/", label: "Route", match: "/route/" },
];
const { commit, date } = data.builtFrom;
const short = commit === "unknown" ? "unknown" : commit.slice(0, 7);
const pageTitle = title === "Archē" ? "Archē" : `${title} · Archē`;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline set:html={THEME_INIT} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class:list={["wrap", wide && "wide"]}>
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}>Archē</a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path.startsWith(n.match) ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" class:list={["wrap", wide && "wide"]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class:list={["wrap", wide && "wide"]}>
        <p>
          Built from <a href={`${REPO_URL}/commit/${commit}`}>{short}</a> on {date}.
          Content and code: <a href={`${REPO_URL}/blob/main/LICENSE`}>Apache-2.0</a>.
          <a href={REPO_URL}>Source on GitHub</a>.
        </p>
        <p>
          This site sets no cookies and loads nothing from anywhere else. It is hosted on GitHub Pages,
          which may log visits under GitHub's own privacy statement.
        </p>
        <fieldset class="theme" hidden data-theme-control>
          <legend>Theme</legend>
          <label><input type="radio" name="theme" value="system" /> System</label>
          <label><input type="radio" name="theme" value="light" /> Light</label>
          <label><input type="radio" name="theme" value="dark" /> Dark</label>
        </fieldset>
      </div>
    </footer>
    <script>
      import { initThemeControl } from "../scripts/theme";
      initThemeControl();
    </script>
  </body>
</html>
