{
  "name": "arche-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "python3 ../tools/export_site.py --out .generated/site-data.json && node scripts/build-math-font.mjs",
    "dev": "npm run generate && astro dev",
    "build": "npm run generate && astro build",
    "preview": "astro preview --port 4321",
    "test": "npm run generate && vitest run",
    "check:links": "node scripts/check-links.mjs dist",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/stix-two-math": "5.3.0",
    "astro": "7.4.13",
    "elkjs": "0.12.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "subset-font": "2.9.0",
    "vitest": "5.1.1"
  }
}
