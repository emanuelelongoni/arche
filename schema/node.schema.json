{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arche.academy/schema/node.schema.json",
  "title": "Topic node",
  "description": "One schedulable topic. One node per file: graph/nodes/<course-id>/<node-id>.yaml. See spec/SCHEMA.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "course", "kind", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "<course prefix>.<kebab-slug>, e.g. ts.compact-in-hausdorff-closed"
    },
    "title": { "type": "string", "minLength": 3 },
    "course": { "type": "string" },
    "section": { "type": "integer", "minimum": 1 },
    "kind": {
      "enum": ["definition", "theorem", "example", "counterexample", "technique", "concept"]
    },
    "status": {
      "enum": ["stub", "draft", "reviewed"],
      "description": "stub: placeholder so edges can point at it; draft: agent-written; reviewed: a human has signed it off"
    },
    "minutes": { "type": "integer", "minimum": 5, "maximum": 120 },
    "knowledge_points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 5 }
    },
    "requires": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/edge" },
          { "$ref": "#/$defs/choice" }
        ]
      }
    },
    "encompasses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "weight"],
        "properties": {
          "node": { "type": "string" },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "illuminates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "note"],
        "properties": {
          "node": { "type": "string" },
          "note": { "type": "string", "minLength": 5 }
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decl"],
        "properties": {
          "decl": { "type": "string", "description": "Fully qualified Lean declaration name in the pinned Mathlib" },
          "library": { "enum": ["mathlib", "formalpedia", "lean-core"], "default": "mathlib" },
          "note": { "type": "string" }
        }
      }
    },
    "verification": {
      "enum": ["formal", "partial", "informal"],
      "description": "formal: every knowledge point's key statements have anchors; partial: some do; informal: none can be checked in Lean"
    },
    "covers": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+#[a-z0-9-]+$" },
      "description": "Coverage items from course files, as <course-id>#<item-id>"
    },
    "only_in": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Viewpoint ids in which this node exists. Omitted: all viewpoints."
    },
    "lesson_notes": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Per-viewpoint guidance for lesson writers, keyed by viewpoint id"
    },
    "off_platform": { "type": "string", "description": "A prompt for personal, off-platform exploration" },
    "msc": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9]{2}[A-Z-][0-9xX]{2}$" }
    },
    "sources": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["draft", "reviewed"] } } },
      "then": { "required": ["section", "minutes", "knowledge_points", "verification"] }
    }
  ],
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "reason"],
      "properties": {
        "node": { "type": "string" },
        "reason": { "type": "string", "minLength": 10, "description": "One sentence naming the specific dependency" }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice", "default", "options"],
      "properties": {
        "choice": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Global choice-group id" },
        "default": { "type": "string" },
        "options": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/edge" }
          }
        }
      }
    }
  }
}
